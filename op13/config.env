# ===== OP13 自编内核 + 自签 ReSukiSU 管理器 统一配置 =====
# 本文件可提交(无秘密)。证书 hash 是公开值(你 keystore 证书的 sha256)，非私钥。

# --- 自签证书(你的 keystore 的证书指纹；keystore 私钥本身不进仓库) ---
# RSA-2048(证书 785B < 内核 CERT_MAX_LENGTH 1024)。换 keystore 必须重算这两个值并重编内核。
KSU_EXPECTED_SIZE=785
KSU_EXPECTED_HASH=3374a2760b60fb189a0ef24f8ca3a9b2af60819654ce6e633a42b03dd73cbfdb

# --- keystore 签名参数(本地用文件；CI 用 secrets 注入这些) ---
KS_ALIAS=op13
KS_STOREPASS=op13pass
KS_KEYPASS=op13pass

# --- 上游源(构建期 fresh clone，跟随上游) ---
RESUKISU_REPO=https://github.com/ReSukiSU/ReSukiSU
RESUKISU_BRANCH=main
SUSFS_REPO=https://github.com/cctv18/susfs4oki
SUSFS_BRANCH=oki-android15-6.6

# --- 内核版本串(必须 = 手机 UTS_RELEASE) ---
KERNEL_SUFFIX=android15-8-g29d86c5fc9dd-abogki428889875-4k
